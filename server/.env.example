# MySQL local - ne jamais committer un vrai mot de passe
DATABASE_URL="mysql://root:@localhost:3306/aej_immersion_db"

# Secret aleatoire long, obligatoire en environnement reel
JWT_SECRET="remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum"
JWT_EXPIRES_IN="8h"

PORT=5000
CLIENT_ORIGIN="http://localhost:3000"

# Utilise uniquement par npm run db:seed
SEED_PASSWORD="remplacer-par-un-mot-de-passe-de-test"
SUPER_ADMIN_PASSWORD="AEjadmin2026"

# SMTP optionnel pour l'envoi des codes OTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=utilisateur@example.com
# SMTP_PASS=mot-de-passe-ou-mot-de-passe-application
# SMTP_FROM="AEJ Immersion <no-reply@example.com>"
